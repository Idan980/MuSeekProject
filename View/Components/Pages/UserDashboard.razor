@page "/user-dashboard"
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>לוח בקרה משתמש - MuSeek</PageTitle>

@if (isAuthorized)
{
    <div class="container mt-4">
        <h2>לוח בקרה - משתמש (User)</h2>
        <p>שלום @Session?.Username, ברוך הבא לאזור האישי שלך!</p>
    </div>
}

@code {
    // משתנה דגל המאשר את הצגת התוכן רק אם המשתמש מורשה
    private bool isAuthorized = false;

    protected override void OnInitialized()
    {
        // 1. אם אין משתמש מחובר -> מעבר לדף הבית
        if (Session == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        // 2. אם המשתמש מחובר אך התפקיד אינו User (RoleId = 2) -> הפניה לדף אין הרשאה
        if (Session.RoleId < 2)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        // 3. אישור הצגת התוכן בדף
        isAuthorized = true;
    }
}