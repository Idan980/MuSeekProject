            <span class="w-1.5 h-1.5 rounded-full bg-[#00d2ff] animate-ping"></span>
            <span class="text-[11px] text-[#bbc9cf]">סנכרון תדרים אקטיבי</span>
        </div>
        <span class="text-[#3c494e]">•</span>
        <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ddb8ff]"></span>
            <span class="text-[11px] text-[#bbc9cf]">פרופיל טעם דינמי</span>
        </div>
        <span class="text-[#3c494e]">•</span>
        <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#859399]"></span>
            <span class="text-[11px] text-[#bbc9cf]">אלגוריתם תאימות שמע MuSeek v2</span>
        </div>
