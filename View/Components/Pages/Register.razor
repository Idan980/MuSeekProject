</div>

<script>
    function toggleRegisterPassword() {
        const el = document.getElementById('password-input');
        const icon = document.getElementById('pwd-icon');
        if (el.type === 'password') {
            el.type = 'text';
            icon.innerText = 'visibility_off';
        } else {
            el.type = 'password';
            icon.innerText = 'visibility';
        }
    }
</script>

@code {
    private string username = "";
    private string usernameError = "";

    private string email = "";
    private string emailError = "";

    private string password = "";
    private string confirmPassword = "";
    private string confirmPasswordError = "";

    private string? errorMessage;
    private bool isBusy = false;
    private bool isRegistered = false;
    private int secondsLeft = 5;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        if (!MailAddress.TryCreate(email.Trim(), out _))
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;

        try
        {
            bool usernameExists = await Http.GetFromJsonAsync<bool>($"api/users/exists/{Uri.EscapeDataString(username.Trim())}");
            if (usernameExists)
            {
                errorMessage = "שם המשתמש כבר תפוס. בחרו שם אחר.";
                return;
            }

            bool emailExists = await Http.GetFromJsonAsync<bool>($"api/users/email-exists/{Uri.EscapeDataString(email.Trim())}");
            if (emailExists)
            {
                errorMessage = "האימייל הזה כבר רשום במערכת.";
                return;
            }

            User newUser = new User(username.Trim(), email.Trim(), password);
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users", newUser);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }

            isRegistered = true;
            while (secondsLeft > 0)
            {
                StateHasChanged();
                await Task.Delay(1000);
                secondsLeft--;
            }
            Navigation.NavigateTo("login");
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleRegister()
    {
        usernameError = "";
        emailError = "";
        confirmPasswordError = "";
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        if (!MailAddress.TryCreate(email.Trim(), out _))
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;

        try
        {
            bool usernameExists = await Http.GetFromJsonAsync<bool>($"api/users/exists/{Uri.EscapeDataString(username.Trim())}");
            if (usernameExists)
            {
                errorMessage = "שם המשתמש כבר תפוס. בחרו שם אחר.";
                return;
            }

            bool emailExists = await Http.GetFromJsonAsync<bool>($"api/users/email-exists/{Uri.EscapeDataString(email.Trim())}");
            if (emailExists)
            {
                errorMessage = "האימייל הזה כבר רשום במערכת.";
                return;
            }

            User newUser = new User(username.Trim(), email.Trim(), password);
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users", newUser);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }

            isRegistered = true;
            while (secondsLeft > 0)
            {
                StateHasChanged();
                await Task.Delay(1000);
                secondsLeft--;
            }
            Navigation.NavigateTo("login");
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
        }
        finally
        {
            isBusy = false;
        }
    }
}