                       InputIcon="person"
                       Placeholder="בחר כינוי לפרופיל שלך..."
                       @bind-Value="username"
                       ErrorMessage="@usernameError" />

                <Field Label="אימייל"
                       InputIcon="alternate_email"
                       Type="email"
                       Dir="ltr"
                       Placeholder="name@gmail.com"
                       @bind-Value="email"
                       ErrorMessage="@emailError" />

                <Field Label="סיסמה"
                       InputIcon="lock"
                       Type="password"
                       Placeholder="••••••••"
                       @bind-Value="password" />

                <Field Label="אימות סיסמה"
                       InputIcon="lock_reset"
                       Type="password"
                       Placeholder="••••••••"
                       @bind-Value="confirmPassword"
