                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                                            חסימה
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Row 2: Host User -->
                            <tr class="hover:bg-white/[0.03] transition-colors group">
                                <td class="py-4 px-6 font-mono text-xs text-slate-400">#MS-1084</td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#62259b] to-purple-400 p-0.5 flex-shrink-0">
                                            <div class="w-full h-full rounded-full bg-[#121318] flex items-center justify-center font-bold text-xs text-purple-300">
                                                מר
                                            </div>
                                        </div>
                                        <div>
                                            <div class="font-semibold text-white group-hover:text-purple-300 transition-colors">מאיה רוזן</div>
                                            <div class="text-xs text-slate-500">@@maya_waves</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6 text-slate-300 font-mono text-xs">maya.rozen@producer.fm</td>
                                <td class="py-4 px-6 text-center">
                                    <!-- Badge צבעוני: Host בסגול -->
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#62259b]/30 text-purple-300 border border-purple-500/40 shadow-sm shadow-purple-500/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                                        Host
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-slate-400 text-xs">28 פברואר 2024</td>
                                <td class="py-4 px-6 text-left">
                                    <div class="inline-flex items-center gap-2">
                                        <button class="px-3 py-1.5 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/20 text-xs font-semibold transition-all flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
