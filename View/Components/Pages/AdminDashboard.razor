                                            <div class="w-full h-full rounded-full bg-[#121318] flex items-center justify-center font-bold text-xs text-blue-300">
                                                תש
                                            </div>
                                        </div>
                                        <div>
                                            <div class="font-semibold text-white group-hover:text-blue-300 transition-colors">תומר שחר</div>
