            <!-- Stats Cards: 3 Compact Glowing Cards -->
            <section class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <!-- Card 1: סך משתמשים -->
                <div class="glass-card rounded-2xl p-6 relative overflow-hidden group transition-all duration-300 hover:-translate-y-1 glow-cyan">
                    <div class="absolute top-0 right-0 h-1 w-full bg-gradient-to-l from-[#00d2ff] to-transparent"></div>
                    <div class="flex items-start justify-between">
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">משתמשים רשומים</span>
                            <div class="text-3xl md:text-4xl font-extrabold text-white mt-2 font-display">1,240</div>
                            <div class="flex items-center gap-1.5 mt-2.5 text-xs text-emerald-400 font-medium">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
                                <span>+12.4% השבוע</span>
                            </div>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-[#00d2ff]/10 border border-[#00d2ff]/30 flex items-center justify-center text-[#00d2ff] group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                        </div>
                    </div>
                </div>

                <!-- Card 2: מארחים פעילים -->
                <div class="glass-card rounded-2xl p-6 relative overflow-hidden group transition-all duration-300 hover:-translate-y-1 glow-purple">
                    <div class="absolute top-0 right-0 h-1 w-full bg-gradient-to-l from-[#8b5cf6] to-[#62259b]"></div>
                    <div class="flex items-start justify-between">
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">מארחים פעילים (Creators)</span>
                            <div class="text-3xl md:text-4xl font-extrabold text-white mt-2 font-display">85</div>
                            <div class="flex items-center gap-1.5 mt-2.5 text-xs text-purple-300 font-medium">
                                <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
                                <span>18 בלייב סטרים עכשיו</span>
                            </div>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-[#62259b]/25 border border-purple-500/30 flex items-center justify-center text-purple-300 group-hover:scale-110 transition-transform">
