                                <th class="py-4 px-6 font-semibold text-center">תפקיד נוכחי</th>
                                <th class="py-4 px-6 font-semibold">תאריך הצטרפות</th>
                                <th class="py-4 px-6 font-semibold text-left">פעולות ניהול</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 font-sans">
                            <!-- Row 1: Admin User -->
                            <tr class="hover:bg-white/[0.03] transition-colors group">
                                <td class="py-4 px-6 font-mono text-xs text-slate-400">#MS-1001</td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#00d2ff] to-[#62259b] p-0.5 flex-shrink-0">
                                            <div class="w-full h-full rounded-full bg-[#121318] flex items-center justify-center font-bold text-xs text-cyan-300">
                                                אל
                                            </div>
                                        </div>
                                        <div>
                                            <div class="font-semibold text-white group-hover:text-cyan-400 transition-colors">אלכס דוידוב</div>
                                            <div class="text-xs text-slate-500">@@alex_sound</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6 text-slate-300 font-mono text-xs">alex@museek.io</td>
                                <td class="py-4 px-6 text-center">
                                    <!-- Badge צבעוני: Admin בציאן -->
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#00d2ff]/15 text-[#00d2ff] border border-[#00d2ff]/40 shadow-sm shadow-cyan-500/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#00d2ff]"></span>
                                        Admin
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-slate-400 text-xs">12 ינואר 2024</td>
                                <td class="py-4 px-6 text-left">
                                    <div class="inline-flex items-center gap-2">
                                        <button class="px-3 py-1.5 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/20 text-xs font-semibold transition-all flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                            ערוך תפקיד
                                        </button>
