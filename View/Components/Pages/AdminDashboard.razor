@page "/admin-dashboard"
@inject UserSession Session
@inject NavigationManager Navigation

@if (isAuthorized)
{
    <!DOCTYPE html>
    <html lang="he" dir="rtl" class="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>לוח בקרה למנהל (AdminDashboard) - MuSeek</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
        <script>
                tailwind.config = {
                    darkMode: 'class',
                    theme: {
                        extend: {
                            fontFamily: {
                                sans: ['Inter', 'sans-serif'],
                                display: ['Plus Jakarta Sans', 'Inter', 'sans-serif']
                            },
                            colors: {
                                darkBg: '#0d0e12',
                                cardBg: 'rgba(22, 24, 31, 0.90)',
                                cyanGlow: '#00d2ff',
                                purpleGlow: '#62259b',
                                accentViolet: '#8b5cf6'
                            }
                        }
                    }
                }
        </script>
        <style>
                body {
                    background-color: #0d0e12;
                    color: #e2e8f0;
                    font-family: 'Inter', system-ui, -apple-system, sans-serif;
                }

                .glass-card {
                    background: rgba(22, 24, 31, 0.90);
                    backdrop-filter: blur(16px);
                    -webkit-backdrop-filter: blur(16px);
                    border: 1px solid rgba(255, 255, 255, 0.08);
                }

                    .glass-card:hover {
                        border-color: rgba(0, 210, 255, 0.25);
                    }

                .glow-cyan {
                    box-shadow: 0 0 25px -5px rgba(0, 210, 255, 0.25);
                }

                .glow-purple {
                    box-shadow: 0 0 25px -5px rgba(98, 37, 155, 0.35);
                }
        </style>
    </head>
    <body class="min-h-screen bg-[#0d0e12] text-slate-100 antialiased p-4 md:p-8 relative overflow-x-hidden">
        <!-- Dynamic Ambient Glow Backdrops -->
        <div class="fixed top-[-10%] right-[-5%] w-[450px] h-[450px] bg-[#62259b]/20 rounded-full blur-[120px] pointer-events-none -z-10"></div>
        <div class="fixed bottom-[-10%] left-[-5%] w-[500px] h-[500px] bg-[#00d2ff]/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>
        <div class="fixed top-[40%] left-[20%] w-[350px] h-[350px] bg-[#8b5cf6]/10 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <!-- Main Container (Standalone Inner View - No Header/Navbar) -->
        <main class="max-w-7xl mx-auto space-y-8">

            <!-- Page Header Title & Subtitle -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-white/5">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold mb-2">
                        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                        מרכז שליטה ובקרה • MuSeek System Core
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight font-display text-white">לוח בקרה למנהל</h1>
                    <p class="text-slate-400 text-sm mt-1">ניהול הרשאות משתמשים, ניטור פעילות קהילה ופיקוח על תדרי המערכת</p>
                </div>

                <div class="flex items-center gap-3">
                    <button class="px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-sm font-medium text-slate-300 transition-all flex items-center gap-2">
                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        ייצוא דוח מערכת
                    </button>
