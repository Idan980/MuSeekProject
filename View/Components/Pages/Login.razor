@page "/login"
@using System.Net
@using Model
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>MuSeek - התחברות</PageTitle>
<div class="w-full min-h-[calc(100vh-5rem)] flex flex-col items-center justify-center p-4 py-8 overflow-y-auto bg-[#0d0e12] relative" dir="rtl">

    <!-- Background Glow & Cosmic Waves -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-40 right-1/4 w-[550px] h-[550px] rounded-full bg-[#62259b]/20 blur-[150px]"></div>
        <div class="absolute -bottom-40 left-10 w-[550px] h-[550px] rounded-full bg-[#00d2ff]/15 blur-[160px]"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-5xl h-[600px] opacity-25 mix-blend-screen pointer-events-none">
            <svg class="w-full h-full" fill="none" viewBox="0 0 1200 600" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="cosmicWave1" x1="0%" y1="50%" x2="100%" y2="50%">
                        <stop offset="0%" stop-color="#00d2ff" stop-opacity="0.1" />
                        <stop offset="50%" stop-color="#00d2ff" stop-opacity="0.6" />
                        <stop offset="80%" stop-color="#ddb8ff" stop-opacity="0.7" />
                        <stop offset="100%" stop-color="#62259b" stop-opacity="0.1" />
                    </linearGradient>
                    <linearGradient id="cosmicWave2" x1="100%" y1="50%" x2="0%" y2="50%">
                        <stop offset="0%" stop-color="#ddb8ff" stop-opacity="0.1" />
                        <stop offset="50%" stop-color="#62259b" stop-opacity="0.5" />
                        <stop offset="100%" stop-color="#00d2ff" stop-opacity="0.4" />
                    </linearGradient>
                </defs>
                <path d="M-50 300 C180 180, 360 440, 600 280 C840 120, 1020 420, 1250 280" fill="none" stroke="url(#cosmicWave1)" stroke-width="2" />
                <path d="M-50 330 C170 440, 420 180, 620 320 C820 470, 1010 160, 1250 330" fill="none" opacity="0.7" stroke="url(#cosmicWave2)" stroke-dasharray="6 4" stroke-width="1.5" />
            </svg>
        </div>
    </div>

    <!-- Main Login Card Wrapper -->
    <div class="relative z-10 w-full max-w-md mx-auto my-auto">

        <!-- Login Card -->
        <div class="bg-[#16181f]/90 backdrop-blur-2xl rounded-2xl p-5 md:p-6 shadow-[0_10px_40px_rgba(0,0,0,0.6)] border border-[#3c494e]/50 relative overflow-hidden">

            <!-- Top Accent Line -->
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-[#00d2ff] to-[#ddb8ff]"></div>

            <!-- Header / Brand Logo -->
            <div class="flex flex-col items-center text-center mb-6">
                <a href="#" style="display: inline-flex !important; flex-direction: row !important; align-items: center !important; gap: 10px !important; text-decoration: none;">
                    <LogoWithText />
                </a>
                <h1 class="text-xl font-bold text-white tracking-tight mb-1">ברוך שובך ל-MuSeek</h1>
                <p class="text-xs text-[#bbc9cf]">המוזיקה החדשה שלך ממתינה לך</p>
            </div>

            <!-- הצגת הודעת שגיאה במידה וההתחברות נכשלה -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3 mb-3 rounded-xl bg-red-500/20 border border-red-500/50 text-red-200 text-xs text-right">
                    @errorMessage
                </div>
            }

            <!-- Login Form -->
            <form id="loginForm" class="flex flex-col gap-3.5" @onsubmit="LoginAsync" @onsubmit:preventDefault>

                <!-- Username Input -->
                <Field Label="שם משתמש" Icon="person" Placeholder="הזן שם משתמש" @bind-Value="loginUsername" />

                <!-- Password Input -->
                <Field Label="סיסמה" Icon="lock" Type="password" Placeholder="••••••••" @bind-Value="loginPassword" />

                <!-- Remember Me Checkbox -->
                <div class="flex items-center justify-start gap-2 pt-0.5">
                    <label class="relative flex items-center cursor-pointer select-none">
                        <input id="rememberMe" type="checkbox" checked class="peer sr-only" />
                        <div class="w-4 h-4 rounded bg-[#0d0e12] border border-[#3c494e]/70 peer-checked:bg-[#00d2ff] peer-checked:border-[#00d2ff] flex items-center justify-center transition-all">
                            <span class="material-symbols-outlined text-[#003543] text-[14px] opacity-0 peer-checked:opacity-100 font-bold transition-opacity">check</span>
                        </div>
                        <span class="ms-2 text-xs text-[#bbc9cf]">זכור אותי במכשיר זה</span>
                    </label>
                </div>

                <!-- Submit Button -->
                <button id="loginSubmitBtn" type="submit" disabled="@isBusy" class="w-full py-2.5 px-5 mt-1 rounded-xl bg-[#00d2ff] hover:bg-[#a5e7ff] text-[#003543] font-bold text-sm transition-all duration-300 shadow-[0_0_20px_rgba(0,210,255,0.4)] hover:shadow-[0_0_30px_rgba(0,210,255,0.7)] flex items-center justify-center gap-2 group cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                    <span class="font-bold">@(isBusy ? "מתחבר..." : "התחבר לחשבון")</span>
                    <span class="material-symbols-outlined text-[18px] transition-transform group-hover:-translate-x-1">arrow_back</span>
                </button>
            </form>

            <!-- Divider -->
            <div class="flex items-center gap-3 my-3">
                <div class="flex-1 h-px bg-[#3c494e]/40"></div>
                <span class="text-xs text-[#859399]">או באמצעות</span>
                <div class="flex-1 h-px bg-[#3c494e]/40"></div>
            </div>

            <!-- OAuth Social Login Buttons -->
            <div class="grid grid-cols-2 gap-2.5 mb-3">
                <!-- Spotify Button -->
                <button type="button" class="flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-[#1f1f24] hover:bg-[#292a2e] border border-[#3c494e]/50 text-white text-xs font-semibold transition-colors focus:outline-none">
                    <svg class="w-4 h-4 fill-[#1DB954]" viewBox="0 0 24 24">
                        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.521 17.34c-.21.343-.658.45-1.001.24-2.833-1.731-6.399-2.122-10.601-1.159-.391.089-.781-.157-.87-.548-.089-.391.157-.781.548-.87 4.6-.105 8.552.329 11.685 2.247.343.21.451.658.239 1.001zm1.472-3.272c-.264.43-.83.568-1.26.304-3.242-1.993-8.185-2.568-12.018-1.405-.487.148-1.003-.133-1.151-.62-.148-.487.133-1.003.62-1.151 4.38-1.33 9.824-.69 13.505 1.572.43.264.568.83.304 1.26zm.136-3.419c-3.888-2.308-10.298-2.52-14.011-1.393-.596.181-1.228-.162-1.41-.758-.182-.596.162-1.228.758-1.41 4.269-1.296 11.35-1.05 15.82 1.606.536.318.712 1.013.394 1.549-.318.536-1.013.712-1.551.394z" />
                    </svg>
                    <span>Spotify</span>
                </button>

                <!-- Google Button -->
                <button type="button" class="flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-[#1f1f24] hover:bg-[#292a2e] border border-[#3c494e]/50 text-white text-xs font-semibold transition-colors focus:outline-none">
                    <svg class="w-4 h-4" viewBox="0 0 24 24">
                        <path d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.3 9 5 12 5z" fill="#EA4335" />
                        <path d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z" fill="#4285F4" />
                        <path d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.8s.2-2.1.4-2.8L1.9 6.3C.7 8.7 0 10.3 0 12s.7 3.3 1.9 5.7l3.7-2.9z" fill="#FBBC05" />
                        <path d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.3-6.4-5.2L1.9 16C3.7 19.7 7.5 23 12 23z" fill="#34A853" />
                    </svg>
                    <span>Google</span>
                </button>
            </div>

            <!-- Register Link -->
            <div class="flex items-center justify-center gap-1.5 pt-0.5 text-center text-xs">
                <span class="text-[#bbc9cf]">אין לך משתמש?</span>
                <a href="/register" class="font-bold text-[#00d2ff] hover:text-[#a5e7ff] underline underline-offset-4 decoration-[#00d2ff]/40 hover:decoration-[#00d2ff] transition-all">הירשם עכשיו</a>
            </div>
        </div>

        <!-- Live Listener Pulse Widget -->
        <div class="mt-3 p-2.5 rounded-xl bg-[#16181f]/80 border border-[#3c494e]/40 backdrop-blur-md flex items-center justify-between shadow-lg">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-[#62259b]/30 border border-[#ddb8ff]/30 flex items-center justify-center text-[#ddb8ff]">
                    <span class="material-symbols-outlined text-[18px]">graphic_eq</span>
                </div>
                <div class="text-right">
                    <p class="text-xs font-semibold text-white">חוויית התאמת טעם בזמן אמת</p>
                    <p class="text-[11px] text-[#bbc9cf]">+14.2 אלף מאזינים מחוברים כעת</p>
                </div>
            </div>
            <!-- Equalizer Animated Bars -->
            <div class="flex items-end gap-1 h-5">
                <span class="w-1 bg-[#00d2ff] h-2 rounded-full animate-pulse"></span>
                <span class="w-1 bg-[#00d2ff] h-4 rounded-full animate-pulse" style="animation-delay: 150ms;"></span>
                <span class="w-1 bg-[#ddb8ff] h-5 rounded-full animate-pulse" style="animation-delay: 300ms;"></span>
                <span class="w-1 bg-[#00d2ff] h-3 rounded-full animate-pulse" style="animation-delay: 450ms;"></span>
                <span class="w-1 bg-[#ddb8ff] h-4 rounded-full animate-pulse" style="animation-delay: 200ms;"></span>
            </div>
        </div>

    </div>
</div>

<!-- Toggle Password Script -->
<script>
    function togglePasswordVisibility() {
        const input = document.getElementById('passwordInput');
        const icon = document.getElementById('pwdVisibilityIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }
</script>

@code {
    private string loginUsername = "";
    private string loginPassword = "";
    private string errorMessage = "";
    private bool isBusy = false;

    private async Task LoginAsync()
    {
        errorMessage = "";

        // 1. בדיקת תקינות שדות קלט בסיסית
        if (string.IsNullOrWhiteSpace(loginUsername) || string.IsNullOrWhiteSpace(loginPassword))
        {
            errorMessage = "יש למלא שם משתמש וסיסמה.";
            return;
        }

        isBusy = true;

        try
        {
            // 2. יצירת אובייקט משתמש עם פרטי האימות לשליחה ב-POST
            User credentials = new User
            {
                Username = loginUsername.Trim(),
                Password = loginPassword
            };

            // 3. שליחת הבקשה לבקר ה-UsersController ב-API
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users/login", credentials);

            // 4. בדיקת שגיאות אימות (קוד 401 Unauthorized)
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                errorMessage = "שם המשתמש או הסיסמה שגויים.";
                return;
            }

            // 5. בדיקת תקינות תגובה כללית מהשרת
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            // 6. קריאת אובייקט המשתמש שחזר בצירוף התפקיד שלו
            User? user = await response.Content.ReadFromJsonAsync<User>();
            if (user == null)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            // 7. שמירת פרטי המשתמש בשירות ה-UserSession
            Session.Login(user);

            // 8. מעבר לדף הבית
            Navigation.NavigateTo("");
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
        }
        finally
        {
            isBusy = false;
        }
    }
}