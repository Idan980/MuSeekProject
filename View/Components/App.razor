<!DOCTYPE html>
<html lang="he" dir="rtl" class="bg-[#0d0e12]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="images/MuSeekLogo.png" />
    <title>MuSeek</title>
    <base href="/" />

    <!-- 1. טעינת פונטים מ-Google (Rubik & Syne) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&family=Syne:wght@700;800&display=swap" rel="stylesheet" />

    <!-- 2. טעינת ספרית האייקונים (Material Symbols) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <!-- 3. סקריפט Tailwind CSS מבוסס CDN והגדרות נושא -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Rubik', 'sans-serif'],
                            display: ['Syne', 'sans-serif'],
                        }
                    }
                }
            };
    </script>

    <!-- רכיב Blazor לניהול תגיות Head דינמיות -->
    <HeadOutlet @rendermode="pageRenderMode" />

    <style>
            *, *:focus, *:active {
                outline: none !important;
                box-shadow: none !important;
            }

            /* הגדרות שלד מיידיות לטעינה ראשונה */
            header {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                width: 100% !important;
                z-index: 50 !important;
            }

                header > div {
                    display: flex !important;
                    align-items: center !important;
                    justify-content: space-between !important;
                    width: 100% !important;
                }
    </style>
</head>
<body class="bg-[#0d0e12] font-sans text-white antialiased">
    <Routes @rendermode="pageRenderMode" />

    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private static readonly IComponentRenderMode pageRenderMode =
        new InteractiveServerRenderMode(prerender: false);
}