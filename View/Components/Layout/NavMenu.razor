@inject NavigationManager Navigation

<header class="fixed top-0 inset-x-0 z-50 bg-[#121317]/90 backdrop-blur-xl border-b border-[#3c494e]/40 shadow-[0_4px_30px_rgba(0,0,0,0.6)]">
    <div class="max-w-7xl mx-auto h-20 px-6 flex items-center justify-between" dir="rtl">

        <div class="flex items-center gap-10">
            <a href="/" class="flex items-center gap-2">
                <LogoWithText />
            </a>

            <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
                <NavLink class="px-4 py-2 rounded-xl text-[#bbc9cf] hover:text-white hover:bg-[#1a1b20] transition-colors" href="" Match="NavLinkMatch.All">
                    ראשי
                </NavLink>
                <NavLink class="px-4 py-2 rounded-xl text-[#bbc9cf] hover:text-white hover:bg-[#1a1b20] transition-colors" href="discover">
                    גילוי שירים
                </NavLink>
                <NavLink class="px-4 py-2 rounded-xl text-[#bbc9cf] hover:text-white hover:bg-[#1a1b20] transition-colors" href="taste-mesh">
                    קהילת טעם
                </NavLink>
                <NavLink class="px-4 py-2 rounded-xl text-[#bbc9cf] hover:text-white hover:bg-[#1a1b20] transition-colors" href="genres">
                    ז'אנרים
                </NavLink>
            </nav>
        </div>

        <div class="flex items-center gap-4">
            <a href="/login" class="text-sm font-medium text-[#bbc9cf] hover:text-white transition-colors px-3 py-2">
                התחברות
            </a>
            <a href="/register" class="text-sm font-bold bg-[#00d2ff] hover:bg-[#a5e7ff] text-[#003543] px-5 py-2.5 rounded-xl shadow-[0_0_20px_rgba(0,210,255,0.4)] hover:shadow-[0_0_30px_rgba(0,210,255,0.7)] transition-all">
                הרשמה
            </a>
        </div>

    </div>
</header>