<div class="flex flex-col gap-1 text-right w-full">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-xs font-semibold text-white flex items-center gap-1.5 mb-0.5">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="material-symbols-outlined text-[16px] text-[#00d2ff]">@Icon</span>
            }
            <span>@Label</span>
        </label>
    }

    <div class="relative flex items-center w-full">
        @if (!string.IsNullOrEmpty(InputIcon))
        {
            <span class="material-symbols-outlined absolute right-3 text-[#bbc9cf] pointer-events-none text-lg">@InputIcon</span>
        }

        <input type="@Type"
               dir="@Dir"
               placeholder="@Placeholder"
               required="@IsRequired"
               value="@Value"
               @oninput="OnInputChanged"
               class="w-full bg-[#121317] border border-[#3c494e]/60 text-white placeholder:text-[#bbc9cf]/50 rounded-xl text-xs focus:outline-none focus:border-[#00d2ff] focus:ring-1 focus:ring-[#00d2ff] transition-all duration-200 py-2 @(string.IsNullOrEmpty(InputIcon) ? "px-3.5" : "pr-9 pl-3")" />
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <span class="text-[11px] text-red-400 mt-0.5 font-medium">@ErrorMessage</span>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? InputIcon { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string Dir { get; set; } = "rtl";
    [Parameter] public bool IsRequired { get; set; } = true;
    [Parameter] public string? ErrorMessage { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private Task OnInputChanged(ChangeEventArgs e)
    {
        return ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}